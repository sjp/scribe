{#-
  The image with its text laid over it, in the shape a browser extension
  injects into a page: the picture exactly as it was, and one transparent
  span per word placed on the pixels it was read from, so that the text can
  be selected, searched and read aloud.

  Takes `var.selection_fill` and `var.selection_background`, the colours
  selected text is drawn in, both of them a system colour by default so that
  a selection looks like every other selection the reader makes;
  `var.char_positions`, to give every character a span on its own pixels
  rather than stretching a word across its box; and `var.font_size_mode`,
  `box_height` or `cap_height`, with `var.cap_height_ratio`, to read a box as
  the height of a capital letter, which suits text written in capitals.
-#}
{%- set source = image.data_uri or image.href -%}
{%- set per_char = vars.char_positions | default(false) | flag -%}
{%- set cap_height = (vars.font_size_mode | default("box_height")) == "cap_height" -%}
{%- set cap_ratio = vars.cap_height_ratio | default(0.7) | number -%}
{#- How much of an em the height of a box stands for. -#}
{%- set box_em = cap_ratio if cap_height and cap_ratio > 0 else 1 -%}
<div class="scribe-overlay">
  <style>
    .scribe-overlay { position: relative; display: inline-block; line-height: 0; color-scheme: light dark }
    .scribe-overlay img { display: block; max-width: 100% }
    .scribe-overlay span { position: absolute; color: transparent; white-space: pre; line-height: 1; transform-origin: center }
    .scribe-overlay span::selection { color: {{ vars.selection_fill | default("HighlightText") }}; background: {{ vars.selection_background | default("color-mix(in srgb, Highlight 35%, transparent)") }} }
  </style>
{%- if source %}
  <img src="{{ source }}" width="{{ image.width }}" height="{{ image.height }}" alt="{{ text | replace("\n", " ") }}" />
{%- endif %}
{%- for line in layout.lines %}
{%- for word in line.words or [line] %}
{%- set box = word.rotated_box %}
{%- set left = box.cx - box.width / 2 %}
{%- set top = box.cy - box.height / 2 %}
{#- Characters are placed in the picture's own frame, so a word holding them
    is left unturned and each of them carries the turn already in its box. -#}
{%- set chars = word.chars | default([]) if per_char else [] %}
  <span style="left: {{ left | round(2) }}px; top: {{ top | round(2) }}px; width: {{ box.width | round(2) }}px; height: {{ box.height | round(2) }}px; font-size: {{ (box.height / box_em) | round(2) }}px{% if not chars %}; transform: rotate({{ box.angle_deg | round(2) }}deg){% endif %}">
    {#- Nothing may part one character from the next, or copying the word out
        would part them too. -#}
    {%- if chars %}{% for char in chars %}<span style="left: {{ (char.bbox.x - left) | round(2) }}px; top: {{ (char.bbox.y - top) | round(2) }}px; width: {{ char.bbox.width | round(2) }}px; height: {{ char.bbox.height | round(2) }}px">{{ char.text }}</span>{% endfor %}
    {%- else %}{{ word.text }}
    {%- endif %}</span>
{%- endfor %}
{%- endfor %}
</div>
