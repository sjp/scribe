{#-
  The image with its text laid over it, in the shape a browser extension
  injects into a page: the picture exactly as it was, and one transparent
  span per word placed on the pixels it was read from, so that the text can
  be selected, searched and read aloud.

  Takes `var.text_fill` and `var.selection_background`, the colours selected
  text is drawn in.
-#}
{%- set source = image.data_uri or image.href -%}
<div class="scribe-overlay">
  <style>
    .scribe-overlay { position: relative; display: inline-block; line-height: 0 }
    .scribe-overlay img { display: block; max-width: 100% }
    .scribe-overlay span { position: absolute; color: transparent; white-space: pre; line-height: 1; transform-origin: center }
    .scribe-overlay span::selection { color: {{ vars.text_fill | default("#000") }}; background: {{ vars.selection_background | default("rgba(0, 90, 255, 0.35)") }} }
  </style>
{%- if source %}
  <img src="{{ source }}" width="{{ image.width }}" height="{{ image.height }}" alt="{{ text | replace("\n", " ") }}" />
{%- endif %}
{%- for line in layout.lines %}
{%- for word in line.words or [line] %}
{%- set box = word.rotated_box %}
  <span style="left: {{ (box.cx - box.width / 2) | round(2) }}px; top: {{ (box.cy - box.height / 2) | round(2) }}px; width: {{ box.width | round(2) }}px; height: {{ box.height | round(2) }}px; font-size: {{ box.height | round(2) }}px; transform: rotate({{ box.angle_deg | round(2) }}deg)">{{ word.text }}</span>
{%- endfor %}
{%- endfor %}
</div>
