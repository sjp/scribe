---
source: crates/scribe-core/tests/fixtures.rs
expression: output
---
<div class="scribe-overlay">
  <style>
    .scribe-overlay { position: relative; display: inline-block; line-height: 0 }
    .scribe-overlay img { display: block; max-width: 100% }
    .scribe-overlay svg { position: absolute; left: 0; top: 0; width: 100%; height: 100% }
  </style>
  <img src="data:image/png;base64," width="220" height="140" alt="" />
  <svg xmlns="http://www.w3.org/2000/svg" class="scribe-root" width="220" height="140" viewBox="0 0 220 140" role="img">
    <style>
      .scribe-root { color-scheme: light dark; }
      .scribe-text { user-select: text; -webkit-user-select: text; white-space: pre; }
      .scribe-text::selection, .scribe-text ::selection { fill: HighlightText; background: color-mix(in srgb, Highlight 35%, transparent); }
    </style>
    <g class="scribe-text" font-family="sans-serif" fill="transparent"/>
  </svg>
</div>
