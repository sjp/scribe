<div class="scribe-v8i16z-overlay">
  <style>
    .scribe-v8i16z-overlay { position: relative; display: inline-block; line-height: 0 }
    .scribe-v8i16z-overlay img { display: block; max-width: 100% }
    .scribe-v8i16z-overlay svg { position: absolute; left: 0; top: 0; width: 100%; height: 100% }
  </style>
  <img src="data:image/png;base64," width="220" height="140" alt="" />
  <svg xmlns="http://www.w3.org/2000/svg" id="scribe-v8i16z" class="scribe-v8i16z-root" width="220" height="140" viewBox="0 0 220 140" role="img">
    <style>
      #scribe-v8i16z { color-scheme: light dark; }
      #scribe-v8i16z .scribe-v8i16z-text { all: revert; fill: transparent; stroke: none; font-family: sans-serif; font-style: normal; font-weight: normal; font-variant: normal; font-stretch: normal; letter-spacing: normal; word-spacing: normal; text-anchor: start; text-decoration: none; text-transform: none; direction: ltr; user-select: text; -webkit-user-select: text; white-space: pre; }
      #scribe-v8i16z .scribe-v8i16z-text text, #scribe-v8i16z .scribe-v8i16z-text tspan { fill: inherit; stroke: inherit; font-family: inherit; font-style: inherit; font-weight: inherit; font-variant: inherit; font-stretch: inherit; letter-spacing: inherit; word-spacing: inherit; text-anchor: inherit; text-decoration: inherit; text-transform: inherit; direction: inherit; unicode-bidi: isolate; white-space: inherit; user-select: inherit; -webkit-user-select: inherit; }
      #scribe-v8i16z .scribe-v8i16z-text::selection, #scribe-v8i16z .scribe-v8i16z-text ::selection { fill: HighlightText; background: color-mix(in srgb, Highlight 35%, transparent); }
