---
source: crates/scribe-core/tests/svg.rs
expression: "linked(&hello_world(), Options::new().with(\"text_mode\", \"debug\"))"
---
<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" class="scribe-root" width="284" height="96" viewBox="0 0 284 96" role="img" aria-label="Hello World">
  <style>
    .scribe-root { color-scheme: light dark; }
    .scribe-text { user-select: text; -webkit-user-select: text; white-space: pre; }
    .scribe-text::selection, .scribe-text ::selection { fill: HighlightText; background: color-mix(in srgb, Highlight 35%, transparent); }
  </style>
  <image href="hello.png" width="284" height="96"/>
  <g class="scribe-text" font-family="sans-serif" fill="#000">
    <text class="scribe-line"><tspan class="scribe-word" x="28" y="56.6" font-size="32" textLength="98" lengthAdjust="spacingAndGlyphs">Hello</tspan> <tspan class="scribe-word" x="143" y="56.6" font-size="32" textLength="113" lengthAdjust="spacingAndGlyphs">World</tspan></text>
  </g>
  <g class="scribe-debug" fill="none">
    <rect class="scribe-line-box" x="28" y="31" width="228" height="32" stroke="#06c"/>
    <rect class="scribe-word-box" x="28" y="31" width="98" height="32" stroke="#c00"/>
    <rect class="scribe-word-box" x="143" y="31" width="113" height="32" stroke="#c00"/>
  </g>
</svg>
