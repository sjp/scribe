---
source: crates/scribe-core/tests/fixtures.rs
expression: output
---
<div class="scribe-opale6-overlay">
  <style>
    .scribe-opale6-overlay { position: relative; display: inline-block; line-height: 0 }
    .scribe-opale6-overlay img { display: block; max-width: 100% }
    .scribe-opale6-overlay svg { position: absolute; left: 0; top: 0; width: 100%; height: 100% }
  </style>
  <img src="data:image/png;base64," width="284" height="96" alt="" />
  <svg xmlns="http://www.w3.org/2000/svg" id="scribe-opale6" class="scribe-opale6-root" width="284" height="96" viewBox="0 0 284 96">
    <style>
      #scribe-opale6 { color-scheme: light dark; }
      #scribe-opale6 .scribe-opale6-text { all: revert; fill: transparent; stroke: none; font-family: sans-serif; font-style: normal; font-weight: normal; font-variant: normal; font-stretch: normal; letter-spacing: normal; word-spacing: normal; text-anchor: start; text-decoration: none; text-transform: none; direction: ltr; user-select: text; -webkit-user-select: text; white-space: pre; }
      #scribe-opale6 .scribe-opale6-text text, #scribe-opale6 .scribe-opale6-text tspan { fill: inherit; stroke: inherit; font-family: inherit; font-style: inherit; font-weight: inherit; font-variant: inherit; font-stretch: inherit; letter-spacing: inherit; word-spacing: inherit; text-anchor: inherit; text-decoration: inherit; text-transform: inherit; direction: inherit; unicode-bidi: isolate; white-space: inherit; user-select: inherit; -webkit-user-select: inherit; }
      #scribe-opale6 .scribe-opale6-text::selection, #scribe-opale6 .scribe-opale6-text ::selection { fill: HighlightText; background: color-mix(in srgb, Highlight 35%, transparent); }
    </style>
    <g class="scribe-opale6-text">
      <text class="scribe-opale6-line"><tspan class="scribe-opale6-word" x="26" y="55.4" font-size="33" textLength="105" lengthAdjust="spacingAndGlyphs">Hello</tspan> <tspan class="scribe-opale6-word" x="146" y="56" font-size="35" textLength="111" lengthAdjust="spacingAndGlyphs">World</tspan></text>
    </g>
  </svg>
</div>
